{
  "name": "dotnet-build",
  "version": "14.0.0",
  "description": "[![logo](./logo.jpg)](https://frontliners.nl)",
  "main": "index.js",
  "scripts": {
    "build:slim": "node -e \"const v=process.env.npm_package_version;require('child_process').execFileSync('docker',['build','-f','Dockerfile.slim','-t','frontliners/dotnet-build:slim','-t','frontliners/dotnet-build:'+v+'-slim','.'],{stdio:'inherit'})\"",
    "build:full": "node -e \"const v=process.env.npm_package_version;require('child_process').execFileSync('docker',['build','--build-arg','BASE_IMAGE=frontliners/dotnet-build:'+v+'-slim','-t','frontliners/dotnet-build:latest','-t','frontliners/dotnet-build:'+v,'-t','frontliners/dotnet-build:full','-t','frontliners/dotnet-build:'+v+'-full','.'],{stdio:'inherit'})\"",
    "build": "npm run build:slim && npm run build:full",
    "tag": "docker tag frontliners/dotnet-build",
    "push:slim": "node -e \"const v=process.env.npm_package_version,{execFileSync:r}=require('child_process');['slim',v+'-slim'].forEach(t=>r('docker',['push','frontliners/dotnet-build:'+t],{stdio:'inherit'}))\"",
    "push:full": "node -e \"const v=process.env.npm_package_version,{execFileSync:r}=require('child_process');['latest',v,'full',v+'-full'].forEach(t=>r('docker',['push','frontliners/dotnet-build:'+t],{stdio:'inherit'}))\"",
    "push": "npm run push:slim && npm run push:full",
    "publish": "npm run build && npm run push"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/frontlinersnl/dotnet-build.git"
  },
  "author": "Rick van Lieshout <info@rickvanlieshout.com> (http://rickvanlieshout.com)",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/frontlinersnl/dotnet-build/issues"
  },
  "homepage": "https://github.com/frontlinersnl/dotnet-build#readme"
}
